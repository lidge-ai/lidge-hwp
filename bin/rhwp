#!/bin/sh
# 이 저장소에 들어 있는 포크 rhwp CLI를 플랫폼에 맞게 실행한다.
# 바이너리는 scripts/build-rhwp-cli.sh 로 rhwp/ 에서 다시 만든다.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)
[ "$ARCH" = aarch64 ] && ARCH=arm64
BIN="$DIR/$OS-$ARCH/rhwp"
[ -x "$BIN" ] || { echo "rhwp: $OS-$ARCH 바이너리가 없습니다. scripts/build-rhwp-cli.sh 를 실행하세요." >&2; exit 127; }
exec "$BIN" "$@"
