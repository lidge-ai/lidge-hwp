{
  "name": "lidge-hwp",
  "version": "0.1.0",
  "description": "Local HWP/HWPX editor with verified MCP agent editing",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lidge-ai/lidge-hwp.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:soffice": "node --test test/soffice/*.test.mjs",
    "build:studio": "sh scripts/build-studio.sh",
    "build:office": "node scripts/build-office.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "kordoc": "4.15.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "2.23.0",
    "@docx-editor.dev/react": "2.23.0",
    "@fortune-sheet/react": "1.0.4",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yjs": "13.6.33"
  }
}
